# Backend environment — SAFE PLACEHOLDERS ONLY.
# Copy values you need locally into backend/.env.local (never committed).
# Unified production uses the canonical platform; provider credentials stay there.

# Copy ../configuration.example.toml to ../configuration.toml.
# CLOUD_PLATFORM_CONFIG_FILE=/etc/tofan-cloud/configuration.toml
# Legacy env-only mock mode is available for isolated development/tests.
# LEASEWEB_MODE=mock

APP_ENV=development
# --- Catalog ---
# New retail quotes are refused when the provider catalog is older than this.
CATALOG_MAX_AGE_MINUTES=1440

# --- USD = USDT pricing (wallet/ledger units stay unchanged) ---
# Public USDTIRT buy_price is in toman; the backend multiplies it by 10.
USDT_RATE_API_BASE_URL=https://api.abantether.com
USDT_RATE_MAX_AGE_SECONDS=300

# --- Authentication delivery -------------------------------------------------
# Production must use live. Local log mode returns a development OTP to the UI.
AUTH_DELIVERY_MODE=log
FRONTEND_URL=http://localhost:5173
PLATFORM_API_URL=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_SECONDS=45
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_RESENDS=4

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ServerHub <no-reply@example.com>

PARSGREEN_SIGNATURE=
PARSGREEN_FROM=
PARSGREEN_ENDPOINT=https://login.parsgreen.com/Api/SendSMS.asmx
PARSGREEN_TIMEOUT_MS=10000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
