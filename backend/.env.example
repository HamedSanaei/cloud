# Backend environment — SAFE PLACEHOLDERS ONLY.
# Copy values you need locally into backend/.env.local (never committed).
# Production uses injected environment variables / secrets — no file required.

# --- Leaseweb ---
# mock (safe default) | live (requires a real API key)
LEASEWEB_MODE=mock
# Real paid ordering requires live mode AND this=true. Keep false during discovery.
LEASEWEB_ORDERING_ENABLED=false
# Never commit a real key. Put it in backend/.env.local instead.
LEASEWEB_API_KEY=

# --- Catalog ---
# New retail quotes are refused when the provider catalog is older than this.
CATALOG_MAX_AGE_MINUTES=1440