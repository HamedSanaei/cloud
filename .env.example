# =============================================================================
# Cloud Server — environment template
# Copy to .env (frontend) / backend/.env (backend) for local development.
# NEVER commit real secrets. Production values live in the server-side
# /opt/tofan/cloud/.env (see docs/DEPLOYMENT.md).
# =============================================================================

# --- Frontend (Vite) ---------------------------------------------------------
# When VITE_API_BASE_URL is empty/unset the console runs in demo mode with the
# current mock/empty states. Set it to switch pages to live data.
# In dev use the Vite proxy:  /api  ->  http://localhost:8000
VITE_API_BASE_URL=/api

# Optional static bearer token (prefer login flow + localStorage `cloud-api-token`).
# VITE_API_TOKEN=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=10000

# --- Backend (backend/.env) ---------------------------------------------------
NODE_ENV=development
APP_ENV=development
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgres://cloud:cloud@127.0.0.1:5432/cloud
REDIS_URL=redis://127.0.0.1:6379

# Long random string; signs/derives session material.
AUTH_SECRET=change-me-to-a-long-random-string

# Set COOKIE_SECURE=true behind HTTPS (production). Local HTTP dev: false.
COOKIE_SECURE=false

# Comma-separated allowed CORS origins (empty = same-origin only).
CORS_ORIGIN=

# --- Authentication, email, Google and ParsGreen -----------------------------
# Use "log" only for local development; OTP codes are returned in the dev API response.
AUTH_DELIVERY_MODE=log
FRONTEND_URL=http://localhost:5173
# Opt-in canonical Python backend; leave blank until legacy balances/contracts are reconciled.
# Server-side origin only (never a VITE_* value). See docs/PLATFORM_INTEGRATION.md.
PLATFORM_API_URL=
# Must match the canonical API environment; deployment refuses mismatched environments.
# Private Docker bridge origin: http://cloud-platform-api:8000
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_SECONDS=45
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_RESENDS=4

# SMTP provider for email verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=پارس سرور <no-reply@example.com>

# ParsGreen SOAP SMS service (server-side only).
PARSGREEN_SIGNATURE=
PARSGREEN_FROM=
PARSGREEN_ENDPOINT=https://login.parsgreen.com/Api/SendSMS.asmx
PARSGREEN_TIMEOUT_MS=10000

# Google OAuth 2.0 Authorization Code + PKCE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Provider configuration ---------------------------------------------------
# Copy configuration.example.toml to configuration.toml and configure accounts.
# Provider keys belong only in that private TOML, never in a VITE_* variable.
# Optional override; the local root configuration.toml is discovered automatically.
# CLOUD_PLATFORM_CONFIG_FILE=/etc/tofan-cloud/configuration.toml

# --- Business -----------------------------------------------------------------
DEFAULT_PROVIDER=leaseweb
DEFAULT_SALES_CURRENCY=IRR
# USD = USDT; public USDTIRT ask (toman) is converted to IRR internally.
USDT_RATE_API_BASE_URL=https://api.abantether.com
USDT_RATE_MAX_AGE_SECONDS=300
QUOTE_TTL_MINUTES=15
RENEWAL_LOOKAHEAD_DAYS=3
RENEWAL_GRACE_DAYS=3
LOG_LEVEL=info

# Deployment only: generate a separate 32+ character key on the target.
# Encrypts pre-migration pg_dump backups; never expose as a VITE_* variable.
BACKUP_ENCRYPTION_KEY=

# --- Seed bootstrap (npm run seed) ---------------------------------------------
# SEED_ADMIN_EMAIL=admin@cloud.local
# SEED_ADMIN_PASSWORD=Admin123456!
# SEED_DEMO_EMAIL=demo@cloud.local
# SEED_DEMO_PASSWORD=Demo123456!
# SEED_FX_RATE=620000
# SEED_CREDIT_RIAL=50000000
